\f1\b0\fs24 \cf0 \uc0\u1053 \u1072  \u1091 \u1083 \u1080 \u1094 \u1077  \u1074 \u1080 \u1089 \u1077 \u1083  \u1075 \u1091 \u1089 \u1090 \u1086 \u1081  \u1090 \u1091 \u1084 \u1072 \u1085 , \u1079 \u1072 \u1090 \u1088 \u1091 \u1076 \u1085 \u1103 \u1102 \u1097 \u1080 \u1081  \u1087 \u1088 \u1086 \u1093 \u1086 \u1076  \u1076 \u1072 \u1078 \u1077  \u1074  \u1087 \u1086 \u1083 \u1076 \u1077 \u1085 \u1100 . \u1057 \u1090 \u1072 \u1085 \u1094 \u1080 \u1103  \u1082 \u1072 \u1079 \u1072 \u1083 \u1072 \u1089 \u1100  \u1086 \u1089 \u1086 \u1073 \u1077 \u1085 \u1085 \u1086  \u1086 \u1076 \u1080 \u1085 \u1086 \u1082 \u1086 \u1081  \u1074  \u1090 \u1072 \u1082 \u1091 \u1102  \u1087 \u1086 \u1075 \u1086 \u1076 \u1091 . \u1056 \u1077 \u1076 \u1082 \u1080 \u1077  \u1087 \u1091 \u1090 \u1085 \u1080 \u1082 \u1080  \u1087 \u1088 \u1086 \u1093 \u1086 \u1076 \u1080 \u1083 \u1080  \u1084 \u1080 \u1084 \u1086  \u1079 \u1072 \u1082 \u1088 \u1099 \u1090 \u1099 \u1093  \u1083 \u1072 \u1074 \u1086 \u1082 .\
\uc0\u1057 \u1084 \u1086 \u1090 \u1088 \u1080 \u1090 \u1077 \u1083 \u1100  \u1089 \u1090 \u1072 \u1085 \u1094 \u1080 \u1080  \u1089 \u1080 \u1076 \u1077 \u1083  \u1074  \u1089 \u1074 \u1086 \u1077 \u1081  \u1082 \u1086 \u1085 \u1090 \u1086 \u1088 \u1077 , \u1095 \u1080 \u1090 \u1072 \u1103  \u1089 \u1090 \u1072 \u1088 \u1091 \u1102  \u1075 \u1072 \u1079 \u1077 \u1090 \u1091  1891 \u1075 . \u1052 \u1080 \u1088  \u1082 \u1072 \u1079 \u1072 \u1083 \u1089 \u1103  \u1077 \u1084 \u1091  \u1073 \u1086 \u1083 \u1100 \u1096 \u1080 \u1084  \u1080  \u1087 \u1091 \u1075 \u1072 \u1102 \u1097 \u1080 \u1084 . \u1059  \u1079 \u1076 \u1072 \u1085 \u1080 \u1103  \u1089 \u1090 \u1086 \u1103 \u1083 \u1086  \u1088 \u1086 \u1074 \u1085 \u1086  3 \u1076 \u1086 \u1084 \u1072 , \u1088 \u1072 \u1079 \u1073 \u1088 \u1086 \u1089 \u1072 \u1085 \u1085 \u1099 \u1093  \u1087 \u1086  \u1082 \u1088 \u1072 \u1103 \u1084  \u1087 \u1083 \u1086 \u1097 \u1072 \u1076 \u1080 .\
\uc0\u1042 \u1077 \u1095 \u1077 \u1088 \u1086 \u1084  \u1075 \u1086 \u1088 \u1086 \u1076  \u1087 \u1086 \u1075 \u1088 \u1091 \u1079 \u1080 \u1083 \u1089 \u1103  \u1074  \u1075 \u1083 \u1091 \u1073 \u1086 \u1082 \u1091 \u1102  \u1090 \u1080 \u1096 \u1080 \u1085 \u1091 . \u1057 \u1074 \u1077 \u1095 \u1080  \u1074  \u1086 \u1082 \u1085 \u1072 \u1093  \u1075 \u1086 \u1088 \u1077 \u1083 \u1080  \u1090 \u1091 \u1089 \u1082 \u1083 \u1086  \u1080  \u1087 \u1086 \u1082 \u1072 \u1095 \u1080 \u1074 \u1072 \u1083 \u1080 \u1089 \u1100  \u1085 \u1072  \u1074 \u1077 \u1090 \u1088 \u1091 . \u1053 \u1080 \u1082 \u1090 \u1086  \u1085 \u1077  \u1087 \u1088 \u1080 \u1093 \u1086 \u1076 \u1080 \u1083  \u1080  \u1085 \u1077  \u1091 \u1093 \u1086 \u1076 \u1080 \u1083  \u1095 \u1077 \u1088 \u1077 \u1079  \u1089 \u1090 \u1072 \u1085 \u1094 \u1080 \u1102 .\
