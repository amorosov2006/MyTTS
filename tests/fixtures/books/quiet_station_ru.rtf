\f1\b0\fs24 \cf0 \uc0\u1052 \u1086 \u1089 \u1090  \u1095 \u1077 \u1088 \u1077 \u1079  \u1088 \u1077 \u1082 \u1091  \u1073 \u1099 \u1083  \u1077 \u1076 \u1080 \u1085 \u1089 \u1090 \u1074 \u1077 \u1085 \u1085 \u1099 \u1084  \u1087 \u1091 \u1090 \u1105 \u1084  \u1074  \u1085 \u1086 \u1074 \u1091 \u1102  \u1078 \u1080 \u1079 \u1085 \u1100 , \u1085 \u1086  \u1089 \u1084 \u1086 \u1090 \u1088 \u1080 \u1090 \u1077 \u1083 \u1100  \u1073 \u1086 \u1103 \u1083 \u1089 \u1103  \u1077 \u1075 \u1086  \u1087 \u1077 \u1088 \u1077 \u1089 \u1077 \u1095 \u1100 . \u1044 \u1077 \u1088 \u1077 \u1074 \u1103 \u1085 \u1085 \u1099 \u1077  \u1076 \u1086 \u1089 \u1082 \u1080  \u1089 \u1082 \u1088 \u1080 \u1087 \u1077 \u1083 \u1080  \u1087 \u1086 \u1076  \u1085 \u1086 \u1075 \u1072 \u1084 \u1080  \u1080  \u1082 \u1072 \u1095 \u1072 \u1083 \u1080 \u1089 \u1100  \u1085 \u1072  \u1074 \u1077 \u1090 \u1088 \u1091 . \u1042 \u1086 \u1076 \u1072  \u1074 \u1085 \u1080 \u1079 \u1091  \u1082 \u1072 \u1079 \u1072 \u1083 \u1072 \u1089 \u1100  \u1073 \u1077 \u1089 \u1082 \u1086 \u1085 \u1077 \u1095 \u1085 \u1086  \u1075 \u1083 \u1091 \u1073 \u1086 \u1082 \u1086 \u1081  \u1080  \u1095 \u1105 \u1088 \u1085 \u1086 \u1081 .\
\uc0\u1054 \u1085  \u1089 \u1090 \u1086 \u1103 \u1083  \u1087 \u1086 \u1089 \u1077 \u1088 \u1077 \u1076 \u1080 \u1085 \u1077  \u1084 \u1086 \u1089 \u1090 \u1072 , \u1075 \u1083 \u1103 \u1076 \u1103  \u1085 \u1072  \u1090 \u1077 \u1084 \u1085 \u1099 \u1081  \u1075 \u1086 \u1088 \u1080 \u1079 \u1086 \u1085 \u1090 . \u1055 \u1086 \u1079 \u1072 \u1076 \u1080  \u1086 \u1089 \u1090 \u1072 \u1083 \u1080 \u1089 \u1100  \u1075 \u1086 \u1076 \u1099  \u1089 \u1086 \u1084 \u1085 \u1077 \u1085 \u1080 \u1081  \u1080  \u1085 \u1077 \u1091 \u1076 \u1072 \u1095 . \u1042 \u1087 \u1077 \u1088 \u1077 \u1076 \u1080  \u1078 \u1076 \u1072 \u1083 \u1086  \u1095 \u1090 \u1086 -\u1090 \u1086  \u1085 \u1077 \u1080 \u1079 \u1074 \u1077 \u1089 \u1090 \u1085 \u1086 \u1077 , \u1085 \u1086  \u1101 \u1090 \u1086  \u1091 \u1078 \u1077  \u1085 \u1077  \u1087 \u1091 \u1075 \u1072 \u1083 \u1086  \u1077 \u1075 \u1086  \u1082 \u1072 \u1082  \u1088 \u1072 \u1085 \u1100 \u1096 \u1077 .\
