\f1\b0\fs24 \cf0 \uc0\u1055 \u1080 \u1089 \u1100 \u1084 \u1086  \u1087 \u1088 \u1080 \u1096 \u1083 \u1086  \u1074  \u1089 \u1072 \u1084 \u1099 \u1081  \u1085 \u1077 \u1086 \u1078 \u1080 \u1076 \u1072 \u1085 \u1085 \u1099 \u1081  \u1084 \u1086 \u1084 \u1077 \u1085 \u1090 , \u1082 \u1086 \u1075 \u1076 \u1072  \u1089 \u1084 \u1086 \u1090 \u1088 \u1080 \u1090 \u1077 \u1083 \u1100  \u1091 \u1078 \u1077  \u1085 \u1077  \u1078 \u1076 \u1072 \u1083  \u1085 \u1080 \u1082 \u1072 \u1082 \u1080 \u1093  \u1085 \u1086 \u1074 \u1086 \u1089 \u1090 \u1077 \u1081 .[1] \u1050 \u1086 \u1085 \u1074 \u1077 \u1088 \u1090  \u1073 \u1099 \u1083  \u1087 \u1086 \u1084 \u1103 \u1090  \u1080  \u1075 \u1088 \u1103 \u1079 \u1077 \u1085 , \u1089 \u1083 \u1086 \u1074 \u1085 \u1086  \u1076 \u1086 \u1083 \u1075 \u1086  \u1087 \u1091 \u1090 \u1077 \u1096 \u1077 \u1089 \u1090 \u1074 \u1086 \u1074 \u1072 \u1083  \u1087 \u1086  \u1076 \u1086 \u1088 \u1086 \u1075 \u1072 \u1084 . \u1040 \u1076 \u1088 \u1077 \u1089  \u1085 \u1072 \u1087 \u1080 \u1089 \u1072 \u1085  \u1082 \u1088 \u1072 \u1089 \u1080 \u1074 \u1099 \u1084  \u1087 \u1086 \u1095 \u1077 \u1088 \u1082 \u1086 \u1084 , \u1093 \u1086 \u1090 \u1103  \u1080  \u1089  \u1086 \u1096 \u1080 \u1073 \u1082 \u1072 \u1084 \u1080 .\
\uc0\u1057 \u1084 \u1086 \u1090 \u1088 \u1080 \u1090 \u1077 \u1083 \u1100  \u1086 \u1090 \u1082 \u1088 \u1099 \u1083  \u1087 \u1080 \u1089 \u1100 \u1084 \u1086  \u1076 \u1088 \u1086 \u1078 \u1072 \u1097 \u1080 \u1084 \u1080  \u1088 \u1091 \u1082 \u1072 \u1084 \u1080 . \'ab\'97 \u1042 \u1099  \u1086 \u1087 \u1086 \u1079 \u1076 \u1072 \u1083 \u1080 , \'97 \u1089 \u1082 \u1072 \u1079 \u1072 \u1083  \u1086 \u1085  \u1089 \u1077 \u1073 \u1077  \u1074 \u1089 \u1083 \u1091 \u1093 , \u1087 \u1088 \u1086 \u1095 \u1080 \u1090 \u1072 \u1074  \u1087 \u1077 \u1088 \u1074 \u1099 \u1077  \u1089 \u1090 \u1088 \u1086 \u1082 \u1080 .\'bb \u1045 \u1075 \u1086  \u1089 \u1077 \u1088 \u1076 \u1094 \u1077  \u1079 \u1072 \u1073 \u1080 \u1083 \u1086 \u1089 \u1100  \u1091 \u1095 \u1072 \u1097 \u1105 \u1085 \u1085 \u1086 . \u1041 \u1099 \u1083 \u1086  \u1077 \u1097 \u1105  \u1089 \u1083 \u1080 \u1096 \u1082 \u1086 \u1084  \u1084 \u1085 \u1086 \u1075 \u1086  \u1085 \u1077 \u1103 \u1089 \u1085 \u1086 \u1075 \u1086 .\
\uc0\u1054 \u1085  \u1087 \u1086 \u1085 \u1080 \u1084 \u1072 \u1083 , \u1095 \u1090 \u1086  \u1090 \u1077 \u1087 \u1077 \u1088 \u1100  \u1074 \u1089 \u1105  \u1076 \u1086 \u1083 \u1078 \u1085 \u1086  \u1080 \u1079 \u1084 \u1077 \u1085 \u1080 \u1090 \u1100 \u1089 \u1103 . \u1055 \u1088 \u1086 \u1096 \u1083 \u1086 \u1077  \u1074 \u1086 \u1079 \u1074 \u1088 \u1072 \u1097 \u1072 \u1083 \u1086 \u1089 \u1100  \u1085 \u1077 \u1086 \u1078 \u1080 \u1076 \u1072 \u1085 \u1085 \u1086 . \u1041 \u1091 \u1076 \u1091 \u1097 \u1077 \u1077  \u1082 \u1072 \u1079 \u1072 \u1083 \u1086 \u1089 \u1100  \u1085 \u1077 \u1086 \u1087 \u1088 \u1077 \u1076 \u1077 \u1083 \u1105 \u1085 \u1085 \u1099 \u1084  \u1080  \u1090 \u1088 \u1077 \u1074 \u1086 \u1078 \u1085 \u1099 \u1084 .\
